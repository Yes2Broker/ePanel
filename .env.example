# Copy to .env.local (local) or add in Vercel → Settings → Environment Variables.
# From Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 10 PM report emails (server only — never prefix these with NEXT_PUBLIC_)
GMAIL_USER=reports-sender@gmail.com
GMAIL_APP_PASSWORD=16-character-app-password
# Long random text; the same value goes into supabase/email_schedule.sql
CRON_SECRET=long-random-text-at-least-24-characters

# Phone / PC notifications (Web Push). The public key is already in the code
# (src/lib/push-config.ts); only the private key is secret.
VAPID_PRIVATE_KEY=

# Y2B Assist (AI helper, Groq). Server-only; never put the key in code.
GROQ_API_KEY=
# Optional: Groq model (default openai/gpt-oss-120b, falls back to gpt-oss-20b, then qwen/qwen3.8-27b)
GROQ_MODEL=
